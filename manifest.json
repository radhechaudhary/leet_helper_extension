{
  "manifest_version": 3,
  "name": "Leetcode AI Helper",
  "description": "Chrome extension for leetcode problems",
  "version": "1.0.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "leet_helper@radhe.dev",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "src/content-script.jsx"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}